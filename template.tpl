// Synapse Tag: sends an event from the web container to a server-side GTM
// container running the Synapse Client.
const callInWindow = require('callInWindow');
const copyFromDataLayer = require('copyFromDataLayer');
const copyFromWindow = require('copyFromWindow');
const encodeUriComponent = require('encodeUriComponent');
const generateRandom = require('generateRandom');
const getContainerVersion = require('getContainerVersion');
const getCookieValues = require('getCookieValues');
const getReferrerUrl = require('getReferrerUrl');
const getTimestampMillis = require('getTimestampMillis');
const getType = require('getType');
const getUrl = require('getUrl');
const injectScript = require('injectScript');
const isConsentGranted = require('isConsentGranted');
const JSON = require('JSON');
const localStorage = require('localStorage');
const makeNumber = require('makeNumber');
const makeString = require('makeString');
const Math = require('Math');
const Object = require('Object');
const readCharacterSet = require('readCharacterSet');
const readTitle = require('readTitle');
const sendPixel = require('sendPixel');
const setCookie = require('setCookie');
const setInWindow = require('setInWindow');
const sha256 = require('sha256');
const templateStorage = require('templateStorage');
const toBase64 = require('toBase64');

// The sender script handles POST requests (the data layer, GA4 parameters,
// response push, server commands, MD5, very large events).
const SENDER_VERSION = 'v9';
const DEFAULT_SENDER_URL = 'https://cdn.jsdelivr.net/gh/synapse-marketing/synapse-tag@1/sender.min.js';
const SENDER_LOADED_KEY = 'gtm_synapseTagScriptLoadedCache';
const TEMP_CLIENT_ID_KEY = 'gtm_synapseTagTempClientId';
// Stored user data lives under this name in a cookie and in local storage.
const STORE_KEY = 'synapse';
// A pixel address longer than this goes as a POST instead (or is trimmed when
// the sender script cannot load). The one retry wraps it in base64 again, and
// the server accepts about 16 KB of request line.
const PIXEL_LIMIT = 7000;
// Optional page helper of the Synapse Conversion Tracking plugin: sends a pixel
// with fetch keepalive, so an event fired while the page closes still arrives.
const KEEPALIVE_HELPER = '__synSend';
const KEEPALIVE_READY = '__synSendReady';
const CONSENT_TYPES = [
  'ad_storage',
  'ad_user_data',
  'ad_personalization',
  'analytics_storage',
  'functionality_storage',
  'personalization_storage',
  'security_storage'
];
// First-party cookies with the click and browser ids of advertising platforms.
const AD_COOKIES = [
  '_fbc', '_fbp', '_gtmeec',
  'ttclid', '_ttp',
  '_epik',
  '_scid', '_scclid',
  'taboola_cid',
  'awin_awc', 'awin_sn_awc', 'awin_source',
  'rakuten_site_id', 'rakuten_time_entered', 'rakuten_ran_mid', 'rakuten_ran_eaid', 'rakuten_ran_site_id',
  'synapse_klaviyo_email', 'synapse_klaviyo_kx', 'synapse_klaviyo_viewed_items',
  'outbrain_cid',
  'wg_cid',
  'ps_id',
  'uet_msclkid', '_uetmsclkid', 'uet_vid', '_uetvid',
  '_dm_session_attributes', 'FPGCLAW', '_gcl_aw', 'FPGCLAG', '_gcl_ag', 'FPGCLGB', '_gcl_gb', 'FPGCLDC', '_gcl_dc',
  'li_fat_id',
  '__oppref', '__obref'
];

const pageUrl = getUrl();
if (pageUrl && pageUrl.indexOf('https://gtm-msr.appspot.com/') === 0) {
  return data.gtmOnSuccess();
}

const rows = readRows();
const server = serverAddress();
const eventId = copyFromDataLayer('gtm.uniqueEventId');

if (needsSender()) {
  // In automatic mode an event whose sender script cannot load still goes as a pixel.
  sendWithSender(data.request_type === 'auto' ? () => sendAsPixel(true) : data.gtmOnFailure);
} else {
  sendAsPixel(false);
}

/*==============================================================================
  What is sent and how
==============================================================================*/

function readRows() {
  const list = [];
  [data.custom_data, data.user_data].forEach((table) => {
    if (getType(table) !== 'array') return;
    table.forEach((row) => {
      list.push({ name: row.name, value: row.value, transformation: row.transformation, store: row.store });
    });
  });
  return list;
}

function serverAddress() {
  let domain = data.gtm_server_domain;
  if (domain.indexOf('http://') !== 0 && domain.indexOf('https://') !== 0) domain = 'https://' + domain;
  if (domain.charAt(domain.length - 1) === '/') domain = domain.slice(0, -1);
  let path = data.request_path;
  if (path.charAt(0) !== '/') path = '/' + path;
  return { domain: domain, path: path };
}

// Automatic mode sends a pixel unless the event needs the sender script; the
// size is checked on the finished pixel.
function needsSender() {
  if (data.request_type !== 'auto') return data.request_type === 'post';
  if (data.add_data_layer || data.addGaParameters || data.dataLayerEventPush || data.richsstsse) return true;
  return rows.some((row) => row.transformation === 'md5');
}

function eventName() {
  if (data.event_type === 'standard') return data.event_name_standard || 'page_view';
  if (data.event_type === 'custom') return data.event_name_custom || 'page_view';
  return 'page_view';
}

/*==============================================================================
  Pixel
==============================================================================*/

function sendAsPixel(isFallback) {
  hashRows(() => {
    const request = pixelRequest();
    // Sent as a pixel only because the sender script could not load (blocked):
    // "_synr=2" lets the logs count the event as rescued, next to "_synr=1"
    // of the disguised retry.
    if (isFallback) request.url += '&_synr=2';
    let url = encodePixel(request);
    if (data.request_type === 'auto' && url.length > PIXEL_LIMIT) {
      if (!isFallback) {
        sendWithSender(() => sendAsPixel(true));
        return;
      }
      request.eventData = trimToLimit(request);
      url = encodePixel(request);
    }
    deliverPixel(url);
  });
}

function pixelRequest() {
  const url =
    server.domain + server.path +
    '?v=' + data.protocol_version +
    '&event=' + encodeUriComponent(eventName()) +
    '&_r=' + generateRandom(100000, 999999);
  const eventData = {};
  if (data.add_common) addPageData(eventData);
  if (data.add_consent_state && data.request_type === 'auto') addConsentState(eventData);
  if (data.add_common_cookie && data.request_type === 'auto') addAdCookies(eventData);
  applyTransformations(false);
  rows.forEach((row) => {
    eventData[row.name] = row.value;
  });
  eventData._dcid_temp = tempClientId();
  return { url: url, eventData: eventData };
}

// Automatic mode packs the data into one base64 parameter; the explicit GET
// mode sends every field as its own parameter.
function encodePixel(request) {
  if (data.request_type === 'auto') {
    return request.url + '&dtdc=' + encodeUriComponent(toBase64(JSON.stringify(request.eventData)));
  }
  let url = request.url;
  for (let key in request.eventData) {
    const value = request.eventData[key];
    url += '&' + key + '=' + (value ? encodeUriComponent(value) : '');
  }
  return url;
}

function deliverPixel(url) {
  const retryUrl = disguisedUrl(url);
  if (copyFromWindow(KEEPALIVE_READY) === true && callInWindow(KEEPALIVE_HELPER, url, retryUrl) === true) {
    data.gtmOnSuccess();
    return;
  }
  sendPixel(url, data.gtmOnSuccess, () => sendPixel(retryUrl, data.gtmOnSuccess, data.gtmOnFailure));
}

// The retry is the same request in a disguised shape: a random path with the
// real path and query base64url-encoded in "ei". The edge worker unpacks it;
// without a worker the Synapse Client unpacks it. "_synr=1" marks the hit as
// rescued.
function disguisedUrl(url) {
  const hidden = server.path + url.substring(url.indexOf('?')) + '&_synr=1';
  return server.domain + '/' + randomToken() + '?ei=' + base64Url(hidden);
}

// Last resort when a pixel is too long and the sender script could not load:
// the largest optional fields are halved or left out until the pixel fits.
function trimToLimit(request) {
  const keep = {
    event_id: true, value: true, currency: true, transaction_id: true, user_id: true,
    consent_state: true, common_cookie: true, page_location: true, _dcid_temp: true, _syntrim: true
  };
  if (getType(data.user_data) === 'array') {
    data.user_data.forEach((row) => {
      if (row && row.name) keep[row.name] = true;
    });
  }
  const eventData = {};
  for (let key in request.eventData) eventData[key] = request.eventData[key];
  eventData._syntrim = 1;
  let guard = 0;
  while (encodePixel({ url: request.url, eventData: eventData }).length > PIXEL_LIMIT && guard < 200) {
    guard++;
    let biggest = '';
    let biggestLength = 0;
    Object.keys(eventData).forEach((key) => {
      if (keep[key]) return;
      const length = makeString(JSON.stringify(eventData[key])).length;
      if (length > biggestLength) {
        biggestLength = length;
        biggest = key;
      }
    });
    if (!biggest) break;
    const value = eventData[biggest];
    if (getType(value) === 'array' && value.length > 1) {
      eventData[biggest] = value.slice(0, Math.floor(value.length / 2));
    } else {
      Object.delete(eventData, biggest);
    }
  }
  return eventData;
}

/*==============================================================================
  POST through the sender script
==============================================================================*/

function sendWithSender(onScriptFailure) {
  const configured = data.sender_script_url;
  const url = configured ? configured.replace('${data-script-version}', SENDER_VERSION) : DEFAULT_SENDER_URL;
  const loaded = copyFromWindow(SENDER_LOADED_KEY) || {};
  if (loaded[url]) {
    sendPost();
    return;
  }
  injectScript(
    url,
    () => {
      loaded[url] = true;
      setInWindow(SENDER_LOADED_KEY, loaded);
      sendPost();
    },
    onScriptFailure,
    url
  );
}

function sendPost() {
  const eventData = {};
  if (data.add_common || data.add_data_layer) {
    const page = callInWindow(
      'synapseTagGetData',
      getContainerVersion().containerId,
      eventId,
      data.add_data_layer_use_own_data_model,
      data.add_data_layer_use_only_current_push
    );
    if (data.add_data_layer && page.dataModel) {
      for (let key in page.dataModel) eventData[key] = page.dataModel[key];
    }
    if (data.add_common) {
      addPageData(eventData);
      eventData.screen_resolution = page.screen.width + 'x' + page.screen.height;
      eventData.viewport_size = page.innerWidth + 'x' + page.innerHeight;
    }
  }
  if (data.add_consent_state) addConsentState(eventData);
  if (data.add_common_cookie) addAdCookies(eventData);
  eventData.event_name = eventName();
  eventData.v = makeNumber(data.protocol_version);
  applyTransformations(true);
  rows.forEach((row) => {
    eventData[row.name] = row.value;
  });
  eventData._dcid_temp = tempClientId();
  if (data.addGaParameters && data.gaId) {
    eventData['x-ga-measurement_id'] = data.gaId;
    eventData['x-ga-page_id'] = copyFromDataLayer('gtm.start');
    eventData['x-ga-mp2-richsstsse'] = '';
    eventData['x-ga-mp2-seg'] = 1;
    eventData['x-ga-request_count'] = 1;
    eventData['x-ga-protocol_version'] = 2;
    eventData.v = 2;
  }
  callInWindow(
    'synapseTagSendData',
    eventData,
    server.domain,
    server.path + '?v=' + eventData.v + '&event=' + encodeUriComponent(eventData.event_name) + (data.richsstsse ? '&richsstsse' : ''),
    data.dataLayerEventName,
    data.dataLayerVariableName,
    data.waitForCookies,
    data.useFetchInsteadOfXHR
  );
  data.gtmOnSuccess();
}

/*==============================================================================
  Data of the event
==============================================================================*/

function addPageData(target) {
  target.page_location = getUrl();
  target.page_hostname = getUrl('host');
  target.page_referrer = getReferrerUrl();
  target.page_title = readTitle();
  target.page_encoding = readCharacterSet();
}

function addConsentState(target) {
  const state = {};
  CONSENT_TYPES.forEach((type) => {
    state[type] = isConsentGranted(type);
  });
  target.consent_state = state;
}

function addAdCookies(target) {
  let found = null;
  AD_COOKIES.forEach((name) => {
    const value = getCookieValues(name)[0];
    if (value) {
      found = found || {};
      found[name] = value;
    }
  });
  if (found) target.common_cookie = found;
}

function tempClientId() {
  const id = copyFromWindow(TEMP_CLIENT_ID_KEY) || 'dcid.1.' + getTimestampMillis() + '.' + generateRandom(100000000, 999999999);
  setInWindow(TEMP_CLIENT_ID_KEY, id);
  return id;
}

// SHA-256 runs here with the GTM sha256 API, before the event is built. Digests
// are remembered for the page, so an event fired while the page closes is built
// at once. A value that cannot be hashed on this path (MD5 needs the sender
// script, or the hash failed) is left out, never sent in clear.
function hashRows(done) {
  let pending = 1;
  const release = () => {
    pending--;
    if (pending === 0) done();
  };
  rows.forEach((row) => {
    if (!row.value) return;
    if (row.transformation === 'md5') {
      row.value = undefined;
      return;
    }
    if (row.transformation !== 'sha256hex' && row.transformation !== 'sha256base64') return;
    const input = makeString(row.value).trim().toLowerCase();
    const encoding = row.transformation === 'sha256hex' ? 'hex' : 'base64';
    const cacheKey = 'sha256:' + encoding + ':' + input;
    const known = templateStorage.getItem(cacheKey);
    if (known) {
      row.value = known;
      row.transformation = 'none';
      return;
    }
    pending++;
    sha256(
      input,
      (digest) => {
        templateStorage.setItem(cacheKey, digest);
        row.value = digest;
        row.transformation = 'none';
        release();
      },
      () => {
        row.value = undefined;
        release();
      },
      { outputEncoding: encoding }
    );
  });
  release();
}

// Applies each row's transformation once and stores the values marked for
// later events. MD5 and SHA-256 by the sender script only when it is loaded.
function applyTransformations(senderLoaded) {
  const toStore = [];
  rows.forEach((row) => {
    let value = row.value;
    if (!value) return;
    const transformation = row.transformation;
    if (transformation === 'trim') {
      value = makeString(value).trim();
    } else if (transformation === 'to_lower_case') {
      value = makeString(value).trim().toLowerCase();
    } else if (transformation === 'base64') {
      value = toBase64(makeString(value));
    } else if (senderLoaded && transformation === 'md5') {
      value = callInWindow('synapseTagMD5', makeString(value).trim().toLowerCase());
    } else if (senderLoaded && transformation === 'sha256base64') {
      value = callInWindow('synapseTag256', makeString(value).trim().toLowerCase(), 'B64');
    } else if (senderLoaded && transformation === 'sha256hex') {
      value = callInWindow('synapseTag256', makeString(value).trim().toLowerCase(), 'HEX');
    }
    if (row.store && row.store !== 'none') toStore.push({ name: row.name, value: value, store: row.store });
    row.value = value;
    row.transformation = 'none';
  });
  if (toStore.length) storeValues(toStore);
}

function storeValues(list) {
  const inCookie = readStored(getCookieValues(STORE_KEY)[0]);
  const inLocal = localStorage ? readStored(localStorage.getItem(STORE_KEY)) : {};
  list.forEach((item) => {
    if (!item.value) return;
    if (item.store === 'all' || item.store === 'localStorage') inLocal[item.name] = item.value;
    if (item.store === 'all' || item.store === 'cookies') inCookie[item.name] = item.value;
  });
  if (localStorage && Object.keys(inLocal).length) {
    localStorage.setItem(STORE_KEY, JSON.stringify(inLocal));
  }
  if (Object.keys(inCookie).length) {
    setCookie(STORE_KEY, JSON.stringify(inCookie), { secure: true, domain: 'auto', path: '/' });
  }
}

function readStored(text) {
  const out = {};
  if (!text) return out;
  const saved = JSON.parse(text);
  if (!saved) return out;
  for (let key in saved) {
    if (saved[key]) out[key] = saved[key];
  }
  return out;
}

/*==============================================================================
  Helpers
==============================================================================*/

function base64Url(text) {
  return toBase64(text).split('+').join('-').split('/').join('_').split('=').join('');
}

function randomToken() {
  const chars = 'abcdefghijklmnopqrstuvwxyz0123456789';
  const length = generateRandom(3, 8);
  let token = '';
  for (let i = 0; i < length; i++) token += chars.charAt(generateRandom(0, chars.length - 1));
  return token;
}


